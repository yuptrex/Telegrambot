# ============================================================
# Copy this file to ".env" and fill in your real values there.
# NEVER commit ".env" to git or paste its contents in chat.
# ============================================================

# Telegram Bot Token — from @BotFather
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# MongoDB connection string — from MongoDB Atlas (Database > Connect)
MONGO_URI=REPLACE_WITH_YOUR_MONGODB_URI

# MongoDB database name (any name you want, will be created automatically)
MONGO_DB_NAME=game_bot

# Telegram Channel ID for stats/leaderboard logging.
# Must be a numeric channel ID starting with -100 (e.g. -1001234567890)
# The bot must be added to this channel as an ADMIN.
CHANNEL_ID=REPLACE_WITH_YOUR_CHANNEL_ID

# ------------------------------------------------------------
# Web service (webhook) settings — only needed if you're running
# this as a webhook-based web service (e.g. Render "Web Service").
# Leave both blank to run locally with long polling instead.
# ------------------------------------------------------------

# Public HTTPS base URL of this deployment (no path needed — the bot
# appends its own webhook path). On Render this is auto-detected via
# RENDER_EXTERNAL_URL, so you usually don't need to set this yourself
# there. Example: https://your-service.onrender.com
WEBHOOK_URL=

# Port the web server binds to. Render sets this automatically.
PORT=8080
