# Telegram Bot API token from @BotFather
BOT_TOKEN=

# MongoDB Atlas connection string (include database name in the path)
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/battle-arena?retryWrites=true&w=majority
MONGODB_URI=

# Public base URL of your deployed Render service (no trailing slash), used to register
# the Telegram webhook. Example: https://battle-arena-bot.onrender.com
WEBHOOK_URL=

# Port the Express server listens on. Render sets this automatically; safe to leave blank on Render.
PORT=3000

# Comma-separated Telegram numeric user IDs allowed to run admin commands (/newtournament, /starttournament)
# Example: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Optional: ISO date used as the anchor for season resets (defaults to 2026-01-01 if unset)
SEASON_ANCHOR_DATE=2026-01-01
